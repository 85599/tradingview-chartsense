# ChartSense reads provider keys from the environment when nothing is saved in Settings.
# Copy this file to .env.local and fill in only the provider you use. .env.local is git-ignored.
# Never commit a real key — a key that reaches a public repo or a shared ZIP must be treated
# as leaked and rotated at the provider console immediately.

GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Where config.json and history.json are written. Defaults to ~/.chartsense, which is outside
# the project folder on purpose, so copying, zipping or publishing the source can never carry keys.
# CHARTSENSE_DATA_DIR=

# Required before ChartSense will answer anyone other than localhost. Set a long random value
# (for example `openssl rand -hex 24`) and paste the same value in Settings -> deployment token.
# CHARTSENSE_ACCESS_TOKEN=
